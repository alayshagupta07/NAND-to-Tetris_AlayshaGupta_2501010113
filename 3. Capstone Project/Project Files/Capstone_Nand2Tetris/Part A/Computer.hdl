
CHIP Computer {
    IN reset;

    PARTS:

    // Instruction Memory
    ROM32K(
        address=pc,
        out=instruction
    );

    // CPU
    CPU(
        inM=memoryOut,
        instruction=instruction,
        reset=reset,
        outM=outM,
        writeM=writeM,
        addressM=addressM,
        pc=pc
    );

    // Main Memory
    Memory(
        in=outM,
        load=writeM,
        address=addressM,
        out=memoryOut
    );
}
