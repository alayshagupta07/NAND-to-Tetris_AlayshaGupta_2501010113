
CHIP Memory {
    IN in[16],
       load,
       address[15];

    OUT out[16];

    PARTS:

    // Select RAM or upper memory
    DMux(
        in=load,
        sel=address[14],
        a=loadRAM,
        b=loadUpper
    );

    // Select Screen or Keyboard
    DMux(
        in=loadUpper,
        sel=address[13],
        a=loadScreen,
        b=loadKeyboard
    );

    // RAM16K
    RAM16K(
        in=in,
        load=loadRAM,
        address=address[0..13],
        out=ramOut
    );

    // Screen memory
    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard memory
    Keyboard(
        out=keyboardOut
    );

    // Select RAM or Screen output
    And(
        a=address[14],
        b=notAddress13,
        out=screenSelect
    );

    Not(
        in=address[13],
        out=notAddress13
    );

    Mux16(
        a=ramOut,
        b=screenOut,
        sel=screenSelect,
        out=ramScreenOut
    );

    // Select Keyboard output
    And(
        a=address[14],
        b=address[13],
        out=keyboardSelect
    );

    Mux16(
        a=ramScreenOut,
        b=keyboardOut,
        sel=keyboardSelect,
        out=out
    );
}
